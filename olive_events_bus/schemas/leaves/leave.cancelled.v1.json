{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.olive.local/leaves/leave.cancelled.v1.json",
  "title": "leaves.leave.cancelled.v1",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "leave_id": { "type": "string", "format": "uuid" },
    "client_id": { "type": "string", "format": "uuid" },
    "employee_id": { "type": "string", "format": "uuid" },
    "employee_name": { "type": "string" },
    "leave_type_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string" },
    "start_date": { "type": "string", "format": "date-time" },
    "end_date": { "type": "string", "format": "date-time" },
    "duration": { "type": "string" },
    "purpose_id": { "type": ["string", "null"], "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "format": "uuid" },
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "approver_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" }
        },
        "required": ["id", "approver_id", "status"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "leave_id",
    "client_id",
    "employee_id",
    "employee_name",
    "leave_type_id",
    "status",
    "start_date",
    "end_date",
    "duration",
    "created_at",
    "created_by",
    "approvers"
  ]
}
